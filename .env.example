# Command prefix — e.g. "!" means commands look like "!help"
PREFIX=!

# Shown in !help, !dev, and the neofetch-style !ping report
BOT_NAME=Harmonie

# Shown in !dev
DEV_NAME=Shivansh Kumar
DEV_CONTACT=
DEV_LINKEDIN=https://www.linkedin.com/in/shivansh-kumar-adi
DEV_GITHUB=https://github.com/shivansh07adi-cloud
REPO_LINK=https://github.com/shivansh07adi-cloud/Harmonie
# Shown in the !help footer
PORTFOLIO_LINK=https://shivanshonline.in
# Local file path to a photo to attach with the !dev card (optional — leave blank
# to send text-only). A photo is already bundled in this project at the path below.
DEV_PHOTO_PATH=./assets/dev/dev-photo.png

# Shown in !donate — a QR code image to send along with the caption. A QR is
# already bundled in this project at the path below; leave blank to fall back
# to DONATE_LINK as plain text instead.
DONATE_QR_PATH=./assets/donate/qr.png

# Shown in !donate if DONATE_QR_PATH is blank/missing — leave both blank to disable
DONATE_LINK=

# Required for !search/!gs (Google search via Gemini) and !analytics.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Comma-separated phone numbers (no +, no @s.whatsapp.net) that count as bot owners.
# Currently unused by any command directly, but ctx.isOwner is available for you
# to gate any command you want owner-only.
OWNER_NUMBERS=

# Where Baileys stores your WhatsApp login session. Back this up — deleting it
# means re-scanning the QR code.
SESSION_DIR=./store/session

# Time (24h, IST) the daily auto-quiz posts, for any group with quizzes turned on via !quizzes on
DAILY_QUIZ_TIME=10:00

# Time (24h, IST) the daily group analytics report auto-posts, for any group with
# it turned on via !dailyanalytics on
DAILY_ANALYTICS_TIME=23:00

# SQLite database file path (ranks, warnings, reminders, message logs)
DB_PATH=./store/bot.db
